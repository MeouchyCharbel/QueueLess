# Copy this file to `.env` and fill in real values. Never commit `.env`.
PORT=3000
# The front end's origin, with no trailing slash
CLIENT_ORIGIN=http://localhost:5173
# Neon PostgreSQL connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Long random secret that signs login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Timezone of all business hours (optional, defaults to Asia/Beirut)
APP_TIMEZONE=Asia/Beirut
# Resend API key for email notifications (resend.com > API Keys).
# Optional: without it, emails are printed in the server terminal instead.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without your own domain,
# but then Resend only delivers to the email you signed up with.
EMAIL_FROM=QueueLess <onboarding@resend.dev>
