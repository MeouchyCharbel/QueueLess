# Copy this file to `.env` and fill in real values. Never commit `.env`.
PORT=3000
# The front end's origin, with no trailing slash
CLIENT_ORIGIN=http://localhost:5173
# Optional on the STAGING Render service only. Do not set in production.
# Enables cookie-authenticated requests from this Vercel team's preview URLs.
# CLIENT_PREVIEW_HOST_SUFFIX=-queue-less4.vercel.app
# Neon PostgreSQL connection string (Neon dashboard > Connect)
# For database-writing integration tests ONLY, create a separate database
# named queueless_test, then set QUEUELESS_ALLOW_TEST_WRITES=yes locally.
# NEVER point DATABASE_URL at production while running npm test.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Long random secret that signs login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Timezone of all business hours (optional, defaults to Asia/Beirut)
APP_TIMEZONE=Asia/Beirut
# Resend API key for email notifications (resend.com > API Keys).
# Optional: without it, emails are printed in the server terminal instead.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without your own domain,
# but then Resend only delivers to the email you signed up with.
EMAIL_FROM=QueueLess <onboarding@resend.dev>
